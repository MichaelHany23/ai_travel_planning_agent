# You'll need your own API keys to run this project.
# Copy this file to .env and replace the placeholder values with your real keys.
# NEVER commit the .env file to GitHub — it's in .gitignore for a reason.

# Your personal Google AI Studio key — this powers all the Gemini API calls.
# Grab one for free at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Your personal Tavily API key — this is what lets the agents search the web
# for real-time flight prices, hotel info, restaurant reviews, etc.
# Sign up at: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
